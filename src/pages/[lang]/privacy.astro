---
import Base from "../../layouts/Base.astro";
import { languages, otherLang, ui, path, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base
  lang={lang}
  title={`${t.privacy} | ${t.siteTitle}`}
  description={t.privacyIntro}
  alternate={path(otherLang(lang), "privacy/")}
>
  <h1>{t.privacy}</h1>
  <p>{t.privacyIntro}</p>
  <p class="muted">{t.privacySample}</p>
  <h2>{t.privacyNoCookies}</h2>
  <p>{t.privacyNoCookiesText}</p>
  <h2>{t.privacyHosting}</h2>
  <p>{t.privacyHostingText}</p>
  <h2>{t.privacyContact}</h2>
  <p>{t.privacyContactText}</p>
  <h2>{t.legal}</h2>
  <p>{t.legalText}</p>
</Base>
