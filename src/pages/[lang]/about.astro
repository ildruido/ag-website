---
import Base from "../../layouts/Base.astro";
import { languages, otherLang, ui, path, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Base
  lang={lang}
  title={`${t.about} | ${t.siteTitle}`}
  description={t.aboutIntro}
  alternate={path(otherLang(lang), "about/")}
>
  <h1>{t.about}</h1>
  <p>{t.aboutIntro}</p>
  <p class="muted">{t.aboutSample}</p>
  <h2>{t.aboutHuman}</h2>
  <p>{t.aboutHumanText}</p>
  <h2>{t.aboutAi}</h2>
  <p>{t.aboutAiText}</p>
  <h2>{t.aboutApproval}</h2>
  <p>{t.aboutApprovalText}</p>
</Base>
