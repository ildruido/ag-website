---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { hasCounterpart, otherLang, ui, path, postLang, postSlug } from "../../../lib/i18n";

export async function getStaticPaths() {
  const entries = await getCollection(
    "portfolio",
    (p) => !p.data.draft && postLang(p.id) !== undefined,
  );
  return entries.map((entry) => ({
    params: { lang: postLang(entry.id), slug: postSlug(entry.id) },
    props: {
      entry,
      hasOther: hasCounterpart(
        entry.id,
        entries.map((p) => p.id),
      ),
    },
  }));
}
const { entry, hasOther } = Astro.props;
const lang = postLang(entry.id)!;
const t = ui[lang];
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={`${entry.data.title} | ${t.siteTitle}`}
  description={entry.data.summary}
  alternate={hasOther ? path(otherLang(lang), `portfolio/${postSlug(entry.id)}/`) : undefined}
>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="muted">
      {entry.data.client && <>{entry.data.client} · </>}{entry.data.date.toISOString().slice(0, 10)}
    </p>
    <Content />
  </article>
  <p><a href={path(lang, "portfolio/")}>{t.backPortfolio}</a></p>
</Base>
